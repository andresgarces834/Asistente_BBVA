CHROMA_PATH=data/chroma
CHROMA_COLLECTION=bbva

OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:4b-instruct
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.2

# Fragmentos que se recuperan por pregunta
TOP_K=5
