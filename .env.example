# Estos parámetros valen con Docker y sin Docker. La excepción son las direcciones de los
# servicios (CHROMA_HOST, CHROMA_PORT, OLLAMA_HOST y API_HOST): con Docker las fija
# docker-compose.yml. Con Docker, API_PORT elige el puerto del equipo donde se abre el chat.
PERFIL=local

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH=32

# Vacío = Chroma embebida en CHROMA_PATH. Con host, usa el servidor Chroma.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=bbva

OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:4b-instruct
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.2

# Fragmentos que se recuperan por pregunta
TOP_K=5

# Mensajes previos que se tienen en cuenta en cada respuesta
N_MENSAJES=6
# Base SQLite donde se guardan las conversaciones
HISTORIAL_PATH=data/historial/historial.db
# Reescribe las preguntas de seguimiento antes de buscar
REESCRIBIR_PREGUNTAS=true

# Servidor web (interfaz de chat)
API_HOST=127.0.0.1
API_PORT=8000
